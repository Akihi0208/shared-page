[Unit]
Description=Wudeng Handbook MCP service
After=network-online.target wudeng-web.service
Wants=network-online.target

[Service]
Type=simple
User=wudeng
Group=wudeng
WorkingDirectory=/opt/wudeng-handbook/server
EnvironmentFile=/etc/wudeng-handbook/wudeng.env
ExecStart=/opt/wudeng-handbook/.venv/bin/python mcp_server.py --http --host 127.0.0.1 --port 8792
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wudeng-handbook/data

[Install]
WantedBy=multi-user.target

